{
  "manifest_version": 2,
  "id": "neko.video",
  "name": "Neko Video",
  "version": "1.3.1",
  "description": "B站与抖音资料、图文预览、显式视频采样理解及按需原媒体发送。",
  "author": {"name": "NekoLaska", "url": "https://github.com/znzsofficial"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/znzsofficial/neko-video"},
  "host_application": {"min_version": "1.3.9", "max_version": "1.99.99"},
  "sdk": {"min_version": "2.12.0", "max_version": "2.99.99"},
  "dependencies": [
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.28.1,<1"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=12.0.0"},
    {"type": "python_package", "name": "qrcode", "version_spec": ">=8.0"},
    {"type": "python_package", "name": "bilibili-api-python", "version_spec": ">=17.4.0"}
  ],
  "capabilities": ["send.text", "send.image", "send.custom", "llm.generate", "llm.transcribe_audio"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
